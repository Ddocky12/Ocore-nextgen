# Ocore Unified v3.0 — SELinux Rules for Zygisk Device Profile Spoofer
# Allows u:r:zygote:s0 (preAppSpecialize) to stat/open/read /data/adb/modules/Ocore/cortex/OCORE.json
allow zygote adb_data_file dir { search getattr open read }
allow zygote adb_data_file file { getattr open read }
allow zygote adb_data_file lnk_file { getattr read }
allow zygote system_file dir { search getattr open read }
allow zygote system_file file { getattr open read }
allow zygote shell_data_file dir { search getattr open read }
allow zygote shell_data_file file { getattr open read }

#!/system/bin/sh
# ==============================================================================
# Ocore Unified Performance Engine v3.2.0-NextGen — Game Session State Machine Daemon
# Binary Path: /data/adb/modules/Ocore/system/bin/ocore-game-daemon
#
# Implements Priority 2 & Priority 5.2:
#   - Single-instance enforcement with PID + /proc/<pid>/cmdline identity check
#   - Canonical GameList source: cortex/thunderclash/gamelist.txt
#   - Deterministic State Machine:
#       IDLE -> GAME_DETECTED -> GAME_VALIDATED -> OVERLAY_ACTIVE
#       OVERLAY_ACTIVE -> GAME_EXITED -> OVERLAY_HIDDEN -> IDLE
#   - Immediate dismissal when switching from game to any non-game app (launcher,
#     WhatsApp, browser, settings), screen off, or game process termination/crash
#   - Zero FPS sampling or overlay activity when no validated game is foreground
# ==============================================================================

MODDIR="${MODDIR_OVERRIDE:-/data/adb/modules/Ocore}"
[ ! -d "$MODDIR" ] && MODDIR="${0%/*}/../.."
OCORE_DIR="${OCORE_DIR_OVERRIDE:-/data/adb/ocore}"
OCORE_CONF="$OCORE_DIR/config.conf"
STATE_DIR="$OCORE_DIR/state"
LOG_DIR="$OCORE_DIR/logs"
DAEMON_LOG="$LOG_DIR/daemons_watchdog.log"
GAME_SESS_LOG="$LOG_DIR/gaming_sessions.log"
PID_FILE="$STATE_DIR/pid_ocore_ai"
GAMELIST_TXT="$MODDIR/cortex/thunderclash/gamelist.txt"
BLACKLIST_TXT="$MODDIR/cortex/thunderclash/game_blacklist.txt"
ACTIVE_TXT="$MODDIR/cortex/thunderclash/game-active.txt"
SESSION_STATE_FILE="$STATE_DIR/game_session_state.env"

mkdir -p "$STATE_DIR" "$LOG_DIR" 2>/dev/null

verify_prev_daemon_pid() {
  _vpd_pid="$1"
  [ -z "$_vpd_pid" ] || [ "$_vpd_pid" = "$$" ] || [ ! -d "/proc/$_vpd_pid" ] && return 1
  _vpd_cmd=$(tr '\0' ' ' < "/proc/$_vpd_pid/cmdline" 2>/dev/null)
  _vpd_comm=$(cat "/proc/$_vpd_pid/comm" 2>/dev/null)
  case "$_vpd_cmd $_vpd_comm" in
    *ocore-game-daemon*) return 0 ;;
  esac
  return 1
}

if [ -f "$PID_FILE" ]; then
  old_pid=$(cat "$PID_FILE" 2>/dev/null | tr -dc '0-9')
  if verify_prev_daemon_pid "$old_pid"; then
    kill -TERM "$old_pid" 2>/dev/null
    sleep 0.2 2>/dev/null || sleep 1
  fi
fi

echo "$$" > "$PID_FILE"
[ -w "/proc/$$/oom_score_adj" ] && echo "-300" > "/proc/$$/oom_score_adj" 2>/dev/null

emit_session_state() {
  _ess_state="$1"
  _ess_pkg="${2:-None}"
  _ess_pid="${3:-0}"
  _ess_ovl="${4:-0}"
  _ess_reason="${5:-StateUpdate}"
  _ess_ts=$(date '+%s')
  _ess_auto="${AUTO_FLOATING_HUD:-1}"
  [ "$_ess_auto" = "0" ] && _ess_ovl="0"

  _ess_tmp="${SESSION_STATE_FILE}.tmp.$$"
  cat << EOS > "$_ess_tmp"
SESSION_STATE=$_ess_state
ACTIVE_GAME_PKG=$_ess_pkg
ACTIVE_GAME_PID=$_ess_pid
OVERLAY_ALLOWED=$_ess_ovl
AUTO_FLOATING_HUD=$_ess_auto
STATE_REASON=$_ess_reason
STATE_TIMESTAMP_SEC=$_ess_ts
EOS
  mv -f "$_ess_tmp" "$SESSION_STATE_FILE" 2>/dev/null
}

cleanup_daemon() {
  cur_p=$(cat "$PID_FILE" 2>/dev/null | tr -dc '0-9')
  if [ "$cur_p" = "$$" ]; then
    rm -f "$PID_FILE" 2>/dev/null
    act_g=$(cat "$STATE_DIR/active_game_pkg" 2>/dev/null | tr -d '[:space:]')
    if [ -n "$act_g" ] && [ "$act_g" != "None" ]; then
      emit_session_state "GAME_EXITED" "$act_g" "0" "0" "DaemonStopped"
      emit_session_state "OVERLAY_HIDDEN" "None" "0" "0" "DaemonStopped"
      "$MODDIR/system/bin/ocorectl" game_exit >/dev/null 2>&1
    fi
    emit_session_state "IDLE" "None" "0" "0" "DaemonStopped"
  fi
  exit 0
}
trap cleanup_daemon INT TERM EXIT

log_d() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] [INFO] [OCORE_GAME_DAEMON] $1" >> "$DAEMON_LOG" 2>/dev/null
}

BRIGHTNESS_NODE=""
for bnode in \
  /sys/class/leds/lcd-backlight/brightness \
  /sys/class/backlight/panel0-backlight/brightness \
  /sys/class/backlight/panel/brightness \
  /sys/class/backlight/sprd_backlight/brightness; do
  if [ -f "$bnode" ]; then
    BRIGHTNESS_NODE="$bnode"
    break
  fi
done
if [ -z "$BRIGHTNESS_NODE" ]; then
  for bnode in /sys/class/backlight/*/brightness /sys/class/leds/*backlight*/brightness; do
    if [ -f "$bnode" ]; then
      BRIGHTNESS_NODE="$bnode"
      break
    fi
  done
fi

is_screen_on() {
  if [ -n "$BRIGHTNESS_NODE" ] && [ -f "$BRIGHTNESS_NODE" ]; then
    read -r bval < "$BRIGHTNESS_NODE" 2>/dev/null || bval=""
    bval=$(printf "%s" "$bval" | tr -dc '0-9')
    if [ -n "$bval" ]; then
      [ "$bval" -gt 0 ] && return 0 || return 1
    fi
  fi
  wake=$(dumpsys power 2>/dev/null | grep -E "mWakefulness=|Display Power: state=" | head -n 1)
  case "$wake" in
    *Dozing*|*Asleep*|*OFF*) return 1 ;;
    *) return 0 ;;
  esac
}

get_foreground_pkg() {
  fg_pkg=$(dumpsys activity activities 2>/dev/null | awk '
    /topResumedActivity=/ || /mResumedActivity:/ || /ResumedActivity:/ {
      for (i = 1; i <= NF; i++) {
        if ($i ~ /^[a-zA-Z][a-zA-Z0-9_]*(\.[a-zA-Z0-9_]+)+\//) {
          sub(/\/.*/, "", $i)
          print $i
          exit
        }
      }
    }
  ')
  if [ -z "$fg_pkg" ]; then
    fg_pkg=$(dumpsys window displays 2>/dev/null | awk '
      /mCurrentFocus=/ || /mFocusedApp=/ {
        for (i = 1; i <= NF; i++) {
          if ($i ~ /^[a-zA-Z][a-zA-Z0-9_]*(\.[a-zA-Z0-9_]+)+\//) {
            sub(/\/.*/, "", $i)
            print $i
            exit
          }
        }
      }
    ')
  fi
  echo "$fg_pkg"
}

is_transient_input_or_system_dialog() {
  case "$1" in
    com.android.permissioncontroller|com.google.android.permissioncontroller|com.google.android.inputmethod.*|com.touchtype.swiftkey*|com.baidu.input*|com.sohu.inputmethod*|com.samsung.android.honeyboard*|com.iflytek.inputmethod*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

is_excluded_non_game() {
  _ex_pkg="$1"
  [ -z "$_ex_pkg" ] && return 0
  if is_transient_input_or_system_dialog "$_ex_pkg"; then
    return 0
  fi
  case "$_ex_pkg" in
    android|system|id.ocore.gamecontrol|com.ocore.booster|flar2.devcheck|*launcher*|*Launcher*|*inputmethod*|*keyboard*|com.android.*|com.google.android.gms*|com.google.android.gsf*|com.google.android.youtube*|com.google.android.apps.maps*|com.google.android.gm*|com.whatsapp*|org.telegram.messenger*|com.instagram.android*|com.facebook.katana*|com.zhiliaoapp.musically*|com.ss.android.ugc.trill*|me.weishu.kernelsu*|com.rifsxd.ksunext*|me.bmax.apatch*|com.topjohnwu.magisk*|io.github.a13e300.ksuwebui*|com.termux*)
      return 0
      ;;
  esac
  if [ -f "$BLACKLIST_TXT" ] && grep -qx "$_ex_pkg" "$BLACKLIST_TXT" 2>/dev/null; then
    return 0
  fi
  return 1
}

# Strict GameList validation: ONLY packages in cortex/thunderclash/gamelist.txt are valid games!
is_configured_game() {
  pkg="$1"
  [ -z "$pkg" ] && return 1
  echo "$pkg" | grep -Eq '^[a-zA-Z][a-zA-Z0-9_]*(\.[a-zA-Z0-9_]+)+$' || return 1
  is_excluded_non_game "$pkg" && return 1

  if [ -f "$GAMELIST_TXT" ] && grep -qx "$pkg" "$GAMELIST_TXT" 2>/dev/null; then
    return 0
  fi
  return 1
}

log_d "Ocore Game Session State Machine Daemon v3.2.0-NextGen started (PID=$$)"

LAST_GAME=$(cat "$STATE_DIR/active_game_pkg" 2>/dev/null | tr -d '[:space:]')
[ "$LAST_GAME" = "None" ] && LAST_GAME=""
GAME_START_TS=$(cat "$STATE_DIR/active_game_start_ts" 2>/dev/null | tr -dc '0-9')
[ -z "$GAME_START_TS" ] && GAME_START_TS=$(date '+%s')
GAME_START_CAP=$(cat /sys/class/power_supply/battery/capacity 2>/dev/null | tr -dc '0-9')
LAST_SCREEN_OFF="0"
[ -f "$STATE_DIR/screen_off_state" ] && LAST_SCREEN_OFF=$(cat "$STATE_DIR/screen_off_state" 2>/dev/null | tr -dc '0-9')
LOOP_TICK=0

if [ -z "$LAST_GAME" ]; then
  emit_session_state "IDLE" "None" "0" "0" "DaemonInit"
fi

while true; do
  echo "$$" > "$PID_FILE"
  LOOP_TICK=$((LOOP_TICK + 1))

  GAME_DETECT_MODE="auto"
  AUTO_APPLY_RECOMMENDATION="0"
  GLOBAL_PROFILE="balanced"
  AUTO_FLOATING_HUD="1"
  [ -f "$OCORE_CONF" ] && . "$OCORE_CONF"

  if is_screen_on; then
    if [ "$LAST_SCREEN_OFF" = "1" ]; then
      LAST_SCREEN_OFF="0"
      echo "0" > "$STATE_DIR/screen_off_state"
      "$MODDIR/system/bin/ocorectl" arbiter_sync >/dev/null 2>&1
    fi
  else
    if [ "$LAST_SCREEN_OFF" != "1" ]; then
      LAST_SCREEN_OFF="1"
      echo "1" > "$STATE_DIR/screen_off_state"
      if [ -n "$LAST_GAME" ]; then
        now_epoch=$(date '+%s')
        ts="$(date '+%Y-%m-%d %H:%M:%S')"
        END_CAP=$(cat /sys/class/power_supply/battery/capacity 2>/dev/null | tr -dc '0-9')
        DUR_MIN=$(( (now_epoch - ${GAME_START_TS:-$now_epoch}) / 60 ))
        DRAIN=$(( ${GAME_START_CAP:-0} - ${END_CAP:-0} ))
        [ "$DRAIN" -lt 0 ] && DRAIN=0
        echo "[$ts] [GAME_EXIT] Screen off during game: $LAST_GAME | Duration: ${DUR_MIN}m | Battery Drain: ${DRAIN}%" >> "$GAME_SESS_LOG"
        emit_session_state "GAME_EXITED" "$LAST_GAME" "0" "0" "ScreenOff"
        emit_session_state "OVERLAY_HIDDEN" "None" "0" "0" "ScreenOff"
        LAST_GAME=""
        "$MODDIR/system/bin/ocorectl" game_exit >/dev/null 2>&1
        emit_session_state "IDLE" "None" "0" "0" "ScreenOffIdle"
      else
        emit_session_state "IDLE" "None" "0" "0" "ScreenOffIdle"
        "$MODDIR/system/bin/ocorectl" arbiter_sync >/dev/null 2>&1
      fi
    fi
    sleep 6
    continue
  fi

  if [ "$GAME_DETECT_MODE" = "auto" ] || [ "$GAME_DETECT_MODE" = "per_game" ]; then
    FG_PKG=$(get_foreground_pkg)

    # Allow soft keyboard / permission dialog on top of an active alive game without hiding HUD
    if [ -n "$LAST_GAME" ] && is_transient_input_or_system_dialog "$FG_PKG"; then
      if [ -n "$(/system/bin/toybox pidof "$LAST_GAME" 2>/dev/null)" ]; then
        FG_PKG="$LAST_GAME"
      fi
    fi

    if [ -n "$FG_PKG" ] && is_configured_game "$FG_PKG"; then
      GAME_PID=$(/system/bin/toybox pidof "$FG_PKG" 2>/dev/null | awk '{print $1}')
      if [ -n "$GAME_PID" ] && [ -d "/proc/$GAME_PID" ]; then
        if [ "$LAST_GAME" != "$FG_PKG" ]; then
          # If switching directly from one game to another, exit previous first
          if [ -n "$LAST_GAME" ]; then
            emit_session_state "GAME_EXITED" "$LAST_GAME" "0" "0" "SwitchedGame"
            emit_session_state "OVERLAY_HIDDEN" "None" "0" "0" "SwitchedGame"
            "$MODDIR/system/bin/ocorectl" game_exit >/dev/null 2>&1
          fi
          # State Machine: IDLE -> GAME_DETECTED -> GAME_VALIDATED -> OVERLAY_ACTIVE
          emit_session_state "GAME_DETECTED" "$FG_PKG" "$GAME_PID" "0" "ForegroundDetected"
          emit_session_state "GAME_VALIDATED" "$FG_PKG" "$GAME_PID" "1" "GameListAndProcessVerified"
          LAST_GAME="$FG_PKG"
          GAME_START_TS=$(date '+%s')
          GAME_START_CAP=$(cat /sys/class/power_supply/battery/capacity 2>/dev/null | tr -dc '0-9')
          ts="$(date '+%Y-%m-%d %H:%M:%S')"
          echo "[$ts] [GAME_START] Validated game session: $FG_PKG (PID=$GAME_PID, Bat=${GAME_START_CAP:-N/A}%)" >> "$GAME_SESS_LOG"
          "$MODDIR/system/bin/ocorectl" game_enter "$FG_PKG" >/dev/null 2>&1
          emit_session_state "OVERLAY_ACTIVE" "$FG_PKG" "$GAME_PID" "1" "ActiveGameSession"
        else
          # Refresh PID in case game respawned a process while still in foreground
          emit_session_state "OVERLAY_ACTIVE" "$FG_PKG" "$GAME_PID" "1" "ActiveGameSession"
        fi
      elif [ -n "$LAST_GAME" ]; then
        # Game process crashed or exited
        now_epoch=$(date '+%s')
        ts="$(date '+%Y-%m-%d %H:%M:%S')"
        END_CAP=$(cat /sys/class/power_supply/battery/capacity 2>/dev/null | tr -dc '0-9')
        DUR_MIN=$(( (now_epoch - ${GAME_START_TS:-$now_epoch}) / 60 ))
        DRAIN=$(( ${GAME_START_CAP:-0} - ${END_CAP:-0} ))
        [ "$DRAIN" -lt 0 ] && DRAIN=0
        echo "[$ts] [GAME_EXIT] Game process terminated/crashed: $LAST_GAME | Duration: ${DUR_MIN}m | Battery Drain: ${DRAIN}%" >> "$GAME_SESS_LOG"
        emit_session_state "GAME_EXITED" "$LAST_GAME" "0" "0" "ProcessTerminated"
        emit_session_state "OVERLAY_HIDDEN" "None" "0" "0" "ProcessTerminated"
        LAST_GAME=""
        "$MODDIR/system/bin/ocorectl" game_exit >/dev/null 2>&1
        emit_session_state "IDLE" "None" "0" "0" "IdleAfterExit"
      fi
    elif [ -n "$LAST_GAME" ]; then
      # User switched to launcher, WhatsApp, browser, or closed the game -> IMMEDIATELY hide & exit!
      now_epoch=$(date '+%s')
      ts="$(date '+%Y-%m-%d %H:%M:%S')"
      END_CAP=$(cat /sys/class/power_supply/battery/capacity 2>/dev/null | tr -dc '0-9')
      DUR_MIN=$(( (now_epoch - ${GAME_START_TS:-$now_epoch}) / 60 ))
      DRAIN=$(( ${GAME_START_CAP:-0} - ${END_CAP:-0} ))
      [ "$DRAIN" -lt 0 ] && DRAIN=0
      echo "[$ts] [GAME_EXIT] Left game ($LAST_GAME -> ${FG_PKG:-background}) | Duration: ${DUR_MIN}m | Battery Drain: ${DRAIN}%" >> "$GAME_SESS_LOG"
      emit_session_state "GAME_EXITED" "$LAST_GAME" "0" "0" "ForegroundLeftTo_${FG_PKG:-None}"
      emit_session_state "OVERLAY_HIDDEN" "None" "0" "0" "ForegroundLeftTo_${FG_PKG:-None}"
      LAST_GAME=""
      "$MODDIR/system/bin/ocorectl" game_exit >/dev/null 2>&1
      emit_session_state "IDLE" "None" "0" "0" "Idle"
    fi
  fi

  if [ "$AUTO_APPLY_RECOMMENDATION" = "1" ] && [ -z "$LAST_GAME" ] && [ $((LOOP_TICK % 8)) -eq 0 ]; then
    rec=$("$MODDIR/system/bin/ocorectl" perf_intel 2>/dev/null | awk -F= '/^INTEL_RECOMMENDED=/ {print $2; exit}')
    if [ -n "$rec" ] && [ "$rec" != "$GLOBAL_PROFILE" ]; then
      "$MODDIR/system/bin/ocorectl" profile "$rec" >/dev/null 2>&1
    fi
  fi

  # Adaptive Polling Engine interval: 2s during active game for fast exit detection, 4s when idle
  if [ -n "$LAST_GAME" ]; then
    sleep 2
  else
    sleep 4
  fi
done

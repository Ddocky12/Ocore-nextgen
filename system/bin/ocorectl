  echo "HW_STORAGE_TYPE=${HW_STORAGE_TYPE:-UFS}"
  echo "HW_MANUFACTURER=${HW_MANUFACTURER:-Unknown}"
  echo "HW_BRAND=${HW_BRAND:-Unknown}"
  echo "HW_PRODUCT=${HW_PRODUCT:-Unknown}"
  echo "HW_SOC_MFG=${HW_SOC_MFG:-Unknown}"
  echo "HW_ARCH=${HW_ARCH:-arm64-v8a}"
  echo "HW_DISPLAY_HZ=${HW_DISPLAY_HZ:-60/90/120Hz}"
  echo "HW_VULKAN_CAP=${HW_VULKAN_CAP:-SUPPORTED}"
  echo "CAP_CPU_DVFS=${CAP_CPU_DVFS:-UNKNOWN}"
  echo "CAP_GPU_DVFS=${CAP_GPU_DVFS:-UNKNOWN}"
  echo "CAP_EEM_VOLT=${CAP_EEM_VOLT:-UNSUPPORTED}"
  echo "CAP_THERMAL_PROC=${CAP_THERMAL_PROC:-UNSUPPORTED}"
  echo "CAP_GED_BOOST=${CAP_GED_BOOST:-UNSUPPORTED}"
  echo "CAP_FPSGO=${CAP_FPSGO:-UNSUPPORTED}"
  echo "CAP_CPUSET_EAS=${CAP_CPUSET_EAS:-UNKNOWN}"
  echo "CAP_CHARGER_BYPASS=${CAP_CHARGER_BYPASS:-UNSUPPORTED}"
  echo "CAP_ZRAM_TUNE=${CAP_ZRAM_TUNE:-SUPPORTED}"
  echo "CAP_ZYGISK_SPOOF=${CAP_ZYGISK_SPOOF:-SUPPORTED}"
  echo "RUNTIME_VERIFIED_STATE=${RUNTIME_VERIFIED_STATE:-NOT_RUNTIME_VERIFIED}"
  echo "AVAIL_IO_SCHEDULERS=${AVAIL_IOSCHED}"
  echo "GPU_MODE=${GPU_MODE:-balance}"
  echo "CRIT_BATT_PCT=${CRIT_BATT_PCT:-10}"
  echo "CUSTOM_CPU_MIN_PCT=${CUSTOM_CPU_MIN_PCT:-20}"
  echo "CUSTOM_CPU_MAX_PCT=${CUSTOM_CPU_MAX_PCT:-90}"
  echo "CUSTOM_CPU_GOV=${CUSTOM_CPU_GOV:-schedutil}"
  echo "CUSTOM_GPU_MODE=${CUSTOM_GPU_MODE:-balance}"
  echo "CUSTOM_SWAPPINESS=${CUSTOM_SWAPPINESS:-100}"
  echo "CUSTOM_TOUCH_LEVEL=${CUSTOM_TOUCH_LEVEL:-3}"
  echo "LOAD_AVG=${LOAD_AVG:-0.0}"
  echo "GPU_PROV=$GPU_PROV"
  echo "GPU_FREQ_MHZ=$GPU_FREQ_MHZ"
  echo "GPU_LOAD_PCT=$GPU_LOAD_PCT"
  echo "CPU_GOV=$GOV0"
  echo "AVAIL_GOVS=$AVAIL_GOVS"
  echo "DAEMON_AI=$ST_AI"
  echo "DAEMON_BATTMON=$ST_BATTMON"
  echo "DAEMON_KTUNER=$ST_KTUNER"
  echo "DAEMON_DYNBAT=$ST_DYNBAT"
  echo "DAEMON_THERMCORE=$ST_THERMCORE"
  echo "DAEMON_FPSMON=$ST_FPSMON"
  compute_performance_intelligence
  _SESS_ST="IDLE"
  _OVL_ALLOW="0"
  if [ -f "$STATE_DIR/game_session_state.env" ]; then
    . "$STATE_DIR/game_session_state.env" 2>/dev/null
    _SESS_ST="${SESSION_STATE:-IDLE}"
    _OVL_ALLOW="${OVERLAY_ALLOWED:-0}"
  fi
  echo "SESSION_STATE=$_SESS_ST"
  echo "OVERLAY_ALLOWED=$_OVL_ALLOW"
  echo "AUTO_FLOATING_HUD=${AUTO_FLOATING_HUD:-1}"
  echo "HUD_POLL_INTERVAL_MS=${HUD_POLL_INTERVAL_MS:-2000}"
  echo "FPS_GREEN_PCT=${FPS_GREEN_PCT:-85}"
  echo "FPS_YELLOW_PCT=${FPS_YELLOW_PCT:-60}"
  echo "SMART_RESOURCE_MGR=${SMART_RESOURCE_MGR:-1}"
  echo "ADAPTIVE_GAMING_ENGINE=${ADAPTIVE_GAMING_ENGINE:-1}"
  if [ -f "$STATE_DIR/fps_session_summary.env" ]; then
    cat "$STATE_DIR/fps_session_summary.env" 2>/dev/null
  fi
  echo "=== THERMOD_REPORT ==="
  if [ -f "$STATE_DIR/thermal_zone_map.env" ]; then
    . "$STATE_DIR/thermal_zone_map.env" 2>/dev/null
    _fast_tz_read() {
      _ft_node="$1"; _ft_name="$2"
      _FT_OUT="UNAVAILABLE|0|None|UNAVAILABLE"; _FT_DC=0
      if [ -n "$_ft_node" ] && [ -f "$_ft_node" ]; then
        _ft_raw=""
        read -r _ft_raw < "$_ft_node" 2>/dev/null || _ft_raw=""
        set -- $_ft_raw
        _ft_tok="$1"
        case "$_ft_tok" in
          ""|"-"|"0"|"-127000"|"-274000"|*[!0-9-]*) return 1 ;;
        esac
        if [ "$_ft_tok" -le 0 ] 2>/dev/null; then return 1; fi
        if [ "$_ft_tok" -ge 1000 ] 2>/dev/null; then _FT_DC=$((_ft_tok / 100))
        elif [ "$_ft_tok" -ge 120 ] 2>/dev/null; then _FT_DC="$_ft_tok"
        else _FT_DC=$((_ft_tok * 10)); fi
        if [ "$_FT_DC" -gt 50 ] && [ "$_FT_DC" -lt 1500 ]; then
          _ft_i=$((_FT_DC / 10)); _ft_d=$((_FT_DC % 10))
          _FT_OUT="${_ft_i}.${_ft_d}°C|${_FT_DC}|${_ft_name}|ACTUAL"
          return 0
        fi
      fi
      return 1
    }
    _fast_tz_read "$TZ_NODE_CPU" "$TZ_NAME_CPU"; _S_CPU="$_FT_OUT"; _c_dc="$_FT_DC"
    _fast_tz_read "$TZ_NODE_GPU" "$TZ_NAME_GPU"; _S_GPU="$_FT_OUT"
    if [ "$_S_GPU" = "UNAVAILABLE|0|None|UNAVAILABLE" ] && [ "$_c_dc" -gt 0 ] 2>/dev/null; then
      _g_dc=$((_c_dc - 20))
      _S_GPU="$((_g_dc / 10)).$((_g_dc % 10))°C|${_g_dc}|SoC-Die-Shared(mtktscpu)|ESTIMATED"
    fi
    _fast_tz_read "$TZ_NODE_SOC" "$TZ_NAME_SOC"; _S_SOC="$_FT_OUT"
    _fast_tz_read "$TZ_NODE_BAT" "$TZ_NAME_BAT"; _S_BAT="$_FT_OUT"
    _fast_tz_read "$TZ_NODE_PMIC" "$TZ_NAME_PMIC"; _S_PMIC="$_FT_OUT"
    _fast_tz_read "$TZ_NODE_PA" "$TZ_NAME_PA"; _S_PA="$_FT_OUT"
    _fast_tz_read "$TZ_NODE_WIFI" "$TZ_NAME_WIFI"; _S_WIFI="$_FT_OUT"
    echo "DOMAIN_CPU=$_S_CPU"
    echo "DOMAIN_GPU=$_S_GPU"
    echo "DOMAIN_SOC=$_S_SOC"
    echo "DOMAIN_BAT=$_S_BAT"
    echo "DOMAIN_PMIC=$_S_PMIC"
    echo "DOMAIN_PA=$_S_PA"
    echo "DOMAIN_WIFI=$_S_WIFI"
  else
    "$MODDIR/system/bin/thermod" status 2>/dev/null
  fi
  echo "=== CPU_FREQS ==="
  for _cdir in /sys/devices/system/cpu/cpu[0-9]*; do
    [ -d "$_cdir" ] || continue
    _cid="${_cdir##*/cpu}"
    _cf="$_cdir/cpufreq"
    _on="1"
    [ -f "$_cdir/online" ] && { read -r _on < "$_cdir/online" 2>/dev/null || _on="1"; }
    if [ -f "$_cf/scaling_cur_freq" ]; then
      _cur=0; _min=0; _max=0; _gov="schedutil"
      read -r _cur < "$_cf/scaling_cur_freq" 2>/dev/null || _cur=0
      read -r _min < "$_cf/scaling_min_freq" 2>/dev/null || _min=0
      read -r _max < "$_cf/scaling_max_freq" 2>/dev/null || _max=0
      read -r _gov < "$_cf/scaling_governor" 2>/dev/null || _gov="schedutil"
      echo "${_cid}:${_cur:-0},${_min:-0},${_max:-0},${_on:-1},${_gov:-schedutil}"
    else
      echo "${_cid}:0,0,0,${_on:-1},offline"
    fi
  done
  echo "=== GAMELIST ==="
  if [ -f "$MODDIR/cortex/thunderclash/gamelist.txt" ]; then
    while IFS= read -r _gline || [ -n "$_gline" ]; do
      [ -n "$_gline" ] && echo "$_gline"
    done < "$MODDIR/cortex/thunderclash/gamelist.txt"
  fi
  echo "=== OCORE_STATUS_END ==="
}

# ==============================================================================
# STRICT ALLOWLIST COMMAND ROUTER
# ==============================================================================
cmd=$(sanitize_token "$1")
case "$cmd" in
  status|"")
    print_full_status
    ;;
  hw_scan)
    scan_hardware_capabilities
    cat "$STATE_DIR/hw_capabilities.env" 2>/dev/null
    ;;
  config_migrate)
    migrate_config
    ;;
  config_backup)
    backup_user_profile "$2"
    ;;
  config_restore)
    restore_user_profile "$2"
    ;;
  config_get)
    cat "$OCORE_CONF" 2>/dev/null
    ;;
  config_set)
    _cs_k=$(sanitize_token "$2")
    _cs_v=$(sanitize_token "$3")
    if save_ocore_key "$_cs_k" "$_cs_v"; then
      evaluate_and_apply_arbiter >/dev/null 2>&1
      log_tx "APPLIED" "config_set" "${_cs_k}=${_cs_v}"
      echo "[OK] Committed transaction: ${_cs_k}=${_cs_v}"
    else
      log_tx "ROLLED_BACK" "config_set" "Failed validation for ${_cs_k}=${_cs_v}"
      echo "[ROLLED_BACK] Transaction failed for ${_cs_k}=${_cs_v}"
      exit 1
    fi
    ;;
  arbiter_sync)
    evaluate_and_apply_arbiter
    ;;
  manual_override)
    set_manual_override "$2"
    ;;
  safe_mode)
    _sm_v=$(sanitize_int "$2" "0")
    save_ocore_key "SAFE_MODE" "$_sm_v"
    if [ "$_sm_v" = "1" ]; then
      apply_eem_voltage "STOCK" >/dev/null 2>&1
      evaluate_and_apply_arbiter >/dev/null 2>&1
      log_tx "APPLIED" "safe_mode" "Safe Mode ENABLED"
      echo "[OK] Ocore Safe Mode ENABLED (Priority #2 Override Active)"
    else
      evaluate_and_apply_arbiter >/dev/null 2>&1
      log_tx "APPLIED" "safe_mode" "Safe Mode DISABLED"
      echo "[OK] Ocore Safe Mode DISABLED"
    fi
    ;;
  profile)
    set_global_profile "$2"
    ;;
  apply_temp_profile)
    evaluate_and_apply_arbiter
    ;;
  one_tap_boost)
    sh "$MODDIR/cortex/cache/clear.sh" >/dev/null 2>&1
    "$MODDIR/cortex/cache/flushram" >/dev/null 2>&1
    sync
    safe_write_node "RAM_BOOST" "/proc/sys/vm/drop_caches" "3"
    log_tx "APPLIED" "one_tap_boost" "Flushed RAM and dropped kernel caches"
    echo "[OK] Ocore One-Tap Optimization completed (RAM flushed & caches dropped)"
    ;;
  volt_profile)
    apply_eem_voltage "$2"
    ;;
  volt_custom)
    apply_eem_voltage "CUSTOM" "$2" "$3" "$4" "$5"
    ;;
  eem_verify_persist)
    verify_eem_persistence_if_needed
    ;;
  schedutil_tune)
    _st_v=$(sanitize_int "$2" "1")
    save_ocore_key "SCHEDUTIL_TUNE_ENABLE" "$_st_v"
    [ "$_st_v" = "1" ] && apply_schedutil_ratelimits "$GLOBAL_PROFILE"
    log_tx "APPLIED" "schedutil_tune" "Schedutil Tune=$_st_v"
    echo "[OK] Schedutil Rate-Limit Optimizer set to: $_st_v"
    ;;
  eem_guard)
    _eg_v=$(sanitize_int "$2" "1")
    save_ocore_key "EEM_PERSIST_GUARD" "$_eg_v"
    log_tx "APPLIED" "eem_guard" "EEM Persistence Guard=$_eg_v"
    echo "[OK] EEM Persistence Guard set to: $_eg_v"
    ;;
  cpuset_eas)
    apply_cpuset_eas_opt "$2"
    ;;
  io_opt)
    apply_io_queue_opt "$2" "$3"
    ;;
  cpu_engine)
    set_cpu_engine "$2"
    ;;
  thermal_engine)
    set_thermal_engine "$2"
    ;;
  trip_policy)
    _tp_v=$(sanitize_int "$2" "0")
    save_ocore_key "ALLOW_TRIP_POINT_MOD" "$_tp_v"
    "$MODDIR/system/bin/thermod" trip_policy "$_tp_v"
    ;;
  therm_thresholds)
    _tt_dom=$(sanitize_token "$2")
    _tt_w=$(sanitize_int "$3" "45")
    _tt_h=$(sanitize_int "$4" "48")
    _tt_c=$(sanitize_int "$5" "51")
    case "$_tt_dom" in
      cpu|CPU)
        save_ocore_key "CPU_WARM_C" "$_tt_w"; save_ocore_key "CPU_HOT_C" "$_tt_h"; save_ocore_key "CPU_CRIT_C" "$_tt_c"
        ;;
      gpu|GPU)
        save_ocore_key "GPU_WARM_C" "$_tt_w"; save_ocore_key "GPU_HOT_C" "$_tt_h"; save_ocore_key "GPU_CRIT_C" "$_tt_c"
        ;;
      soc|SOC|ap|AP)
        save_ocore_key "SOC_WARM_C" "$_tt_w"; save_ocore_key "SOC_HOT_C" "$_tt_h"; save_ocore_key "SOC_CRIT_C" "$_tt_c"
        ;;
      bat|BAT|battery)
        save_ocore_key "BAT_WARM_C" "$_tt_w"; save_ocore_key "BAT_HOT_C" "$_tt_h"; save_ocore_key "BAT_CRIT_C" "$_tt_c"
        ;;
      *)
        _tt_w=$(sanitize_int "${2:-45}" "45")
        _tt_h=$(sanitize_int "${3:-48}" "48")
        _tt_c=$(sanitize_int "${4:-51}" "51")
        _tt_hy=$(sanitize_int "${5:-2}" "2")
        save_ocore_key "BAT_WARM_C" "$_tt_w"; save_ocore_key "BAT_HOT_C" "$_tt_h"; save_ocore_key "BAT_CRIT_C" "$_tt_c"
        save_ocore_key "THERM_HYST_C" "$_tt_hy"
        ;;
    esac
    [ -n "$6" ] && save_ocore_key "THERM_HYST_C" "$(sanitize_int "$6" "2")"
    [ -n "$7" ] && save_ocore_key "THERM_COOLDOWN_SEC" "$(sanitize_int "$7" "30")"
    log_tx "APPLIED" "therm_thresholds" "Updated thermal thresholds ($_tt_dom: $_tt_w/$_tt_h/$_tt_c)"
    echo "[OK] Thermal thresholds updated ($_tt_dom: Warm=${_tt_w}°C Hot=${_tt_h}°C Crit=${_tt_c}°C)"
    ;;
  daemon)
    manage_daemon "$2" "$3"
    ;;
  batt_div|ocore_div)
    _bd_div=$(sanitize_token "$2")
    save_ocore_key "OCORE_BATTMON_DIV" "$_bd_div"
    setprop persist.sys.ocore.screenoff_div "$_bd_div" 2>/dev/null
    manage_daemon ocore_battmon restart
    ;;
  thunder_lock)
    _tl_v=$(sanitize_int "$2" "0")
    save_ocore_key "THUNDER_LOCK_FREQ" "$_tl_v"
    [ "$_tl_v" = "0" ] && unlock_cpu_nodes
    log_tx "APPLIED" "thunder_lock" "Hard Frequency Lock=$_tl_v"
    echo "[OK] Ocore Hard Frequency Lock set to: $_tl_v"
    ;;
  governor)
    _gov_v=$(sanitize_token "$2")
    unlock_cpu_nodes
    run_tracked "CPU_GOV" "Set governor to $_gov_v" sh "$MODDIR/cortex/cpu/gov.sh" "$_gov_v"
    log_tx "APPLIED" "governor" "Governor=$_gov_v"
    ;;
  gpu_mode)
    apply_gpu_mode_verified "$2"
    ;;
  cpu_policy_set)
    set_cpu_policy_limits "$2" "$3" "$4" "$5"
    ;;
  custom_profile)
    _cp_min=$(sanitize_int "${2:-20}" "20")
    _cp_max=$(sanitize_int "${3:-90}" "90")
    _cp_gov=$(sanitize_token "${4:-schedutil}")
    _cp_gpu=$(sanitize_token "${5:-balance}")
    _cp_swp=$(sanitize_int "${6:-100}" "100")
    _cp_tch=$(sanitize_int "${7:-3}" "3")
    save_ocore_key "CUSTOM_CPU_MIN_PCT" "$_cp_min"
    save_ocore_key "CUSTOM_CPU_MAX_PCT" "$_cp_max"
    save_ocore_key "CUSTOM_CPU_GOV" "$_cp_gov"
    save_ocore_key "CUSTOM_GPU_MODE" "$_cp_gpu"
    save_ocore_key "CUSTOM_SWAPPINESS" "$_cp_swp"
    save_ocore_key "CUSTOM_TOUCH_LEVEL" "$_cp_tch"
    save_ocore_key "GLOBAL_PROFILE" "custom"
    apply_zram_vm "$_cp_swp" >/dev/null 2>&1
    sh "$MODDIR/cortex/thunderclash/touch.sh" "$_cp_tch" >/dev/null 2>&1
    evaluate_and_apply_arbiter >/dev/null 2>&1
    log_tx "APPLIED" "custom_profile" "Custom Profile applied (CPU:${_cp_min}%-${_cp_max}% $_cp_gov, GPU:$_cp_gpu, Swp:$_cp_swp, Touch:$_cp_tch)"
    echo "[OK] Custom Profile saved and applied (${_cp_min}%-${_cp_max}% $_cp_gov)"
    ;;
  touch)
    _tch_lvl=$(sanitize_int "$2" "2")
    save_ocore_key "TOUCH_LEVEL" "$_tch_lvl"
    run_tracked "TOUCH" "Set touch level $_tch_lvl" sh "$MODDIR/cortex/thunderclash/touch.sh" "$_tch_lvl"
    log_tx "APPLIED" "touch" "Touch Level=$_tch_lvl"
    echo "[OK] Touch response level set to: $_tch_lvl"
    ;;
  refresh)
    _ref_idx=$(sanitize_int "$2" "-1")
    save_ocore_key "REFRESH_IDX" "$_ref_idx"
    echo "$_ref_idx" > "$MODDIR/cortex/thunderclash/refresh_index.txt"
    run_tracked "REFRESH" "Set refresh index $_ref_idx" sh "$MODDIR/cortex/thunderclash/refresh.sh" "$_ref_idx"
    log_tx "APPLIED" "refresh" "Refresh Index=$_ref_idx"
    ;;
  renderer)
    apply_renderer_pipeline "$2"
    ;;
  game_mode_opt)
    _gmo_v=$(sanitize_token "$2")
    case "$_gmo_v" in
      auto|manual|per_game|disabled)
        save_ocore_key "GAME_DETECT_MODE" "$_gmo_v"
        evaluate_and_apply_arbiter >/dev/null 2>&1
        log_tx "APPLIED" "game_mode_opt" "Game Detection Mode=$_gmo_v"
        echo "[OK] Game Detection Mode set to: $_gmo_v"
        ;;
      *)
        log_tx "FAILED" "game_mode_opt" "Invalid mode '$_gmo_v'"
        echo "[ERROR] Invalid game detection mode: $_gmo_v"
        ;;
    esac
    ;;
  game_enter)
    enter_game_session "$2"
    ;;
  game_exit)
    exit_game_session
    ;;
  game_cfg)
    set_per_game_config "$2" "$3" "$4" "$5" "$6"
    ;;
  game_remove|gamelist_remove)
    remove_game_pkg "$2"
    ;;
  gamelist_get)
    sync_gamelist_artifacts
    cat "$MODDIR/cortex/thunderclash/gamelist.txt" 2>/dev/null
    ;;
  gamelist_add)
    _ga_pkg=$(sanitize_token "$2")
    if add_game_to_gamelist "$_ga_pkg"; then
      log_tx "APPLIED" "gamelist_add" "Added $_ga_pkg to cortex/thunderclash/gamelist.txt"
    else
      log_tx "FAILED" "gamelist_add" "Rejected $_ga_pkg"
      exit 1
    fi
    ;;
  gamelist_sync)
    sync_gamelist_artifacts
    log_tx "APPLIED" "gamelist_sync" "Synchronized cortex/thunderclash/gamelist.txt & ocoreApplist.json"
    echo "[OK] Synchronized GameList across module and companion app"
    ;;
  game_session_state|game_session_status|session_status)
    if [ -f "$STATE_DIR/game_session_state.env" ]; then
      cat "$STATE_DIR/game_session_state.env" 2>/dev/null
    else
      echo "SESSION_STATE=IDLE"
      echo "ACTIVE_GAME_PKG=None"
      echo "ACTIVE_GAME_PID=0"
      echo "OVERLAY_ALLOWED=0"
      echo "AUTO_FLOATING_HUD=${AUTO_FLOATING_HUD:-1}"
    fi
    ;;
  auto_hud)
    _ah_v=$(sanitize_int "$2" "1")
    save_ocore_key "AUTO_FLOATING_HUD" "$_ah_v"
    if [ "$_ah_v" = "0" ]; then
      write_game_session_state "OVERLAY_HIDDEN" "None" "0" "0" "AutoHudDisabled"
      command -v am >/dev/null 2>&1 && am startservice -n id.ocore.gamecontrol/.OverlayService -a id.ocore.gamecontrol.ACTION_GAME_EXIT >/dev/null 2>&1 &
    fi
    log_tx "APPLIED" "auto_hud" "AUTO_FLOATING_HUD=$_ah_v"
    echo "[OK] Auto Floating FPS Pill set to: $_ah_v"
    ;;
  hud_poll)
    _hp_v=$(sanitize_int "$2" "2000")
    [ "$_hp_v" -lt 500 ] && _hp_v=500
    [ "$_hp_v" -gt 10000 ] && _hp_v=10000
    save_ocore_key "HUD_POLL_INTERVAL_MS" "$_hp_v"
    log_tx "APPLIED" "hud_poll" "HUD_POLL_INTERVAL_MS=$_hp_v"
    echo "[OK] HUD Polling Interval set to: ${_hp_v}ms"
    ;;
  fps_thresholds)
    _ft_g=$(sanitize_int "${2:-85}" "85")
    _ft_y=$(sanitize_int "${3:-60}" "60")
    save_ocore_key "FPS_GREEN_PCT" "$_ft_g"
    save_ocore_key "FPS_YELLOW_PCT" "$_ft_y"
    log_tx "APPLIED" "fps_thresholds" "Green=${_ft_g}% Yellow=${_ft_y}%"
    echo "[OK] FPS Color Thresholds updated (Green >= ${_ft_g}%, Yellow >= ${_ft_y}%)"
    ;;
  fps_history)
    [ -f "$STATE_DIR/fps_session_summary.env" ] && cat "$STATE_DIR/fps_session_summary.env" 2>/dev/null
    echo "=== FPS_SAMPLES ==="
    [ -f "$LOG_DIR/fps_history.log" ] && tail -n 50 "$LOG_DIR/fps_history.log" 2>/dev/null || true
    ;;
  adaptive_workload)
    evaluate_adaptive_gaming_workload "$2"
    ;;
  config_integrity)
    verify_and_backup_config_integrity
    ;;
  frame_stats)
    get_frame_stability_stats "$2"
    ;;
  perf_intel)
    compute_performance_intelligence
    ;;
  recovery)
    run_recovery_action "$2" "$3"
    ;;
  ocore_prop|ocore_sysprop)
    _op_key=$(sanitize_token "$2")
    _op_val=$(sanitize_token "$3")
    _prop_name="persist.sys.ocore__conf.$_op_key"
    setprop "$_prop_name" "$_op_val" 2>/dev/null
    case "$_op_key" in
      SFL)
        if [ "$_op_val" = "1" ]; then
          resetprop -n debug.sf.early_phase_offset_ns 500000 2>/dev/null
          resetprop -n debug.sf.early_app_phase_offset_ns 500000 2>/dev/null
          resetprop -n debug.sf.high_fps_early_phase_offset_ns 6100000 2>/dev/null
          resetprop -n debug.sf.high_fps_late_app_phase_offset_ns 100000 2>/dev/null
        fi
        ;;
      schedtunes)
        if [ "$_op_val" = "1" ]; then
          safe_write_node "SCHED" "/proc/sys/kernel/sched_migration_cost_ns" "50000"
          safe_write_node "SCHED" "/proc/sys/kernel/sched_min_granularity_ns" "1000000"
          safe_write_node "SCHED" "/proc/sys/kernel/sched_wakeup_granularity_ns" "1500000"
        fi
        ;;
      dnd)
        save_ocore_key "GAME_DND_ENABLE" "$_op_val"
        if [ "$_op_val" = "1" ]; then
          echo "on" > "$MODDIR/cortex/thunderclash/dnd.txt"
          sh "$MODDIR/cortex/thunderclash/dnd.sh" --enable >/dev/null 2>&1
        else
          echo "off" > "$MODDIR/cortex/thunderclash/dnd.txt"
          sh "$MODDIR/cortex/thunderclash/dnd.sh" --disable >/dev/null 2>&1
        fi
        ;;
      APreload)
        save_ocore_key "GAME_PRELOAD_ENABLE" "$_op_val"
        ;;
      logd)
        if [ "$_op_val" = "1" ]; then
          stop logd 2>/dev/null
          safe_write_node "TRACE" "/sys/kernel/tracing/tracing_on" "0" "0644" "0" "1"
        else
          start logd 2>/dev/null
        fi
        ;;
    esac
    log_tx "APPLIED" "ocore_prop" "$_op_key=$_op_val"
    echo "[OK] $_op_key = $_op_val"
    ;;
  bypass_chg)
    _bc_v=$(sanitize_int "$2" "0")
    _bc_node=$(detect_charging_node)
    if [ "$_bc_node" = "UNSUPPORTED" ]; then
      save_ocore_key "BYPASS_CHG_ENABLE" "0"
      log_tx "UNSUPPORTED" "bypass_chg" "Charger control node unsupported"
      echo "[UNSUPPORTED] Bypass charging is not supported by this kernel"
      exit 1
    fi
    save_ocore_key "BYPASS_CHG_ENABLE" "$_bc_v"
    setprop persist.sys.ocore__conf.bypasschg "$_bc_v" 2>/dev/null
    echo "$_bc_v" > "$AZ_CONF_DIR/bypasschgconfig/bypasschg"
    echo "$_bc_v" > "$MODDIR/cortex/bypass/status.txt"
    if [ "$_bc_v" = "1" ]; then
      set_charging_switch disable_charging
      chmod 0755 "$MODDIR/engine/ocore-bypass" 2>/dev/null
      nohup /system/bin/sh "$MODDIR/engine/ocore-bypass" >>"$DAEMON_LOG" 2>&1 &
      log_tx "APPLIED" "bypass_chg" "Bypass Charging enabled ($_bc_node)"
      echo "[OK] Bypass Charging enabled ($_bc_node)"
    else
      graceful_stop_proc "ocore-bypass" "$STATE_DIR/pid_ocore_bypass"
      set_charging_switch enable_charging
      log_tx "APPLIED" "bypass_chg" "Bypass Charging disabled"
      echo "[OK] Bypass Charging disabled"
    fi
    ;;
  smart_charge)
    _sc_v=$(sanitize_int "$2" "0")
    _sc_stop=$(sanitize_int "${3:-85}" "85")
    _sc_res=$(sanitize_int "${4:-75}" "75")
    _sc_node=$(detect_charging_node)
    if [ "$_sc_node" = "UNSUPPORTED" ]; then
      save_ocore_key "SMART_CHARGE_LIMIT" "0"
      log_tx "UNSUPPORTED" "smart_charge" "Charger control node unsupported"
      echo "[UNSUPPORTED] Smart Charging hardware control node not supported on this device"
      exit 1
    fi
    save_ocore_key "SMART_CHARGE_LIMIT" "$_sc_v"
    save_ocore_key "SMART_CHARGE_STOP" "$_sc_stop"
    save_ocore_key "SMART_CHARGE_RESUME" "$_sc_res"
    [ "$_sc_v" = "0" ] && set_charging_switch enable_charging
    log_tx "APPLIED" "smart_charge" "Smart Charge ($_sc_stop%/$_sc_res%)=$_sc_v"
    echo "[OK] Smart Charge Limit ($_sc_stop% / $_sc_res%) set to: $_sc_v"
    ;;
  zram_vm)
    apply_zram_vm "$2"
    ;;
  net_lowlat)
    apply_net_tweaks "$2"
    ;;
  private_dns)
    set_private_dns "$2"
    ;;
  mtk_boost)
    set_mtk_apu_dram "$2"
    ;;
  deep_doze)
    _dd_v=$(sanitize_int "$2" "0")
    save_ocore_key "DEEP_DOZE_ENABLE" "$_dd_v"
    if [ "$_dd_v" = "1" ]; then
      dumpsys deviceidle enable >/dev/null 2>&1
      dumpsys deviceidle force-idle >/dev/null 2>&1
      log_tx "APPLIED" "deep_doze" "Deep Doze enabled"
      echo "[OK] Deep Doze enabled & triggered"
    else
      dumpsys deviceidle unforce >/dev/null 2>&1
      log_tx "APPLIED" "deep_doze" "Deep Doze unforced"
      echo "[OK] Deep Doze unforced"
    fi
    ;;
  ram_boost)
    sh "$MODDIR/cortex/cache/clear.sh" >/dev/null 2>&1
    "$MODDIR/cortex/cache/flushram" >/dev/null 2>&1
    sync
    safe_write_node "RAM_BOOST" "/proc/sys/vm/drop_caches" "3"
    log_tx "APPLIED" "ram_boost" "Flushed RAM & dropped caches"
    echo "[OK] RAM Flushed & Kernel Caches Dropped"
    ;;
  fstrim_now)
    run_tracked "FSTRIM" "Ocore FSTrim" "$MODDIR/system/bin/sys.ocore-utilityconf" FSTrim >/dev/null
    sm fstrim >/dev/null 2>&1
    log_tx "APPLIED" "fstrim_now" "FSTrim completed"
    echo "[OK] FSTrim completed"
    ;;
  list_packages)
    pm list packages -3 2>/dev/null | sed 's/^package://' | sort | head -n 200
    ;;
  spoof_list)
    MODDIR_OVERRIDE="$MODDIR" OCORE_DIR_OVERRIDE="$OCORE_DIR" sh "$MODDIR/cortex/ocore_json_tool.sh" list
    ;;
  spoof_bind)
    bind_zygisk_spoof "$2" "$3" "$4"
    ;;
  spoof_unbind)
    unbind_zygisk_spoof "$2"
    ;;
  spoof_reset)
    reset_zygisk_spoof
    ;;
  spoof_audit)
    MODDIR_OVERRIDE="$MODDIR" OCORE_DIR_OVERRIDE="$OCORE_DIR" sh "$MODDIR/cortex/ocore_json_tool.sh" audit
    ;;
  emergency_charge_recover)
    emergency_charging_recovery
    ;;
  game_blacklist_get)
    cat "$MODDIR/cortex/thunderclash/game_blacklist.txt" 2>/dev/null
    ;;
  game_blacklist_add)
    _gba_p=$(sanitize_token "$2")
    if validate_package_name "$_gba_p"; then
      if ! grep -qx "$_gba_p" "$MODDIR/cortex/thunderclash/game_blacklist.txt" 2>/dev/null; then
        echo "$_gba_p" >> "$MODDIR/cortex/thunderclash/game_blacklist.txt"
      fi
      log_tx "APPLIED" "game_blacklist_add" "Added $_gba_p to game_blacklist.txt"
      echo "[OK] Added $_gba_p to Game Blacklist"
    else
      log_tx "FAILED" "game_blacklist_add" "Invalid package $_gba_p"
      echo "[ERROR] Invalid package name: $_gba_p"
      exit 1
    fi
    ;;
  game_blacklist_remove)
    _gbr_p=$(sanitize_token "$2")
    if [ -n "$_gbr_p" ] && [ -f "$MODDIR/cortex/thunderclash/game_blacklist.txt" ]; then
      grep -vx "$_gbr_p" "$MODDIR/cortex/thunderclash/game_blacklist.txt" > "$MODDIR/cortex/thunderclash/game_blacklist.txt.tmp" 2>/dev/null
      mv -f "$MODDIR/cortex/thunderclash/game_blacklist.txt.tmp" "$MODDIR/cortex/thunderclash/game_blacklist.txt" 2>/dev/null
      log_tx "APPLIED" "game_blacklist_remove" "Removed $_gbr_p from game_blacklist.txt"
      echo "[OK] Removed $_gbr_p from Game Blacklist"
    fi
    ;;
  debug_verbose)
    _dv_v=$(sanitize_int "$2" "1")
    save_ocore_key "DEBUG_VERBOSE" "$_dv_v"
    log_tx "APPLIED" "debug_verbose" "Verbose logging=$_dv_v"
    echo "[OK] Verbose Debug Logging set to: $_dv_v"
    ;;
  diag)
    run_self_diagnostics
    ;;
  export_logs)
    export_diagnostic_bundle
    ;;
  logs)
    cat_type=$(sanitize_token "${2:-all}")
    case "$cat_type" in
      errors)
        echo "=== ERRORS & WARNINGS LOG ($ERROR_LOG) ==="
        if [ -s "$ERROR_LOG" ]; then tail -n 80 "$ERROR_LOG"; else echo "Zero errors recorded!"; fi
        ;;
      boot)
        echo "=== BOOT & POST-FS-DATA TRACE ($BOOT_LOG) ==="
        tail -n 100 "$BOOT_LOG" 2>/dev/null
        ;;
      volt)
        echo "=== EEM VOLTAGE & SCHEDUTIL LOG ($VOLT_LOG) ==="
        if [ -s "$VOLT_LOG" ]; then tail -n 80 "$VOLT_LOG"; else echo "No voltage logs yet."; fi
        ;;
      audit)
        echo "=== KERNEL NODE WRITE & TRANSACTION AUDIT ==="
        tail -n 50 "$TX_LOG" 2>/dev/null
        echo ""
        tail -n 80 "$AUDIT_LOG" 2>/dev/null
        ;;
      daemons)
        echo "=== DAEMONS & WATCHDOG LOG ($DAEMON_LOG) ==="
        tail -n 80 "$DAEMON_LOG" 2>/dev/null
        ;;
      thermod)
        echo "=== OCORE THERMAL INTELLIGENCE LOG ==="
        tail -n 80 "$THERMOD_DIR/logs/thermod.log" 2>/dev/null
        ;;
      perf)
        echo "=== PERFORMANCE & GAMING SESSION HISTORY ==="
        tail -n 60 "$GAME_SESS_LOG" 2>/dev/null
        tail -n 60 "$PERF_HIST_LOG" 2>/dev/null
        ;;
      diag)
        if [ ! -f "$LOG_DIR/self_diagnostic_report.log" ]; then
          run_self_diagnostics >/dev/null 2>&1
        fi
        cat "$LOG_DIR/self_diagnostic_report.log" 2>/dev/null
        ;;
      all|*)
        echo "=== [1] RECENT TRANSACTIONS ==="
        tail -n 15 "$TX_LOG" 2>/dev/null
        echo ""
        echo "=== [2] RECENT ERRORS & WARNINGS ==="
        if [ -s "$ERROR_LOG" ]; then tail -n 20 "$ERROR_LOG"; else echo "Zero errors recorded."; fi
        echo ""
        echo "=== [3] OCORE MASTER EVENTS ==="
        tail -n 25 "$OCORE_LOG" 2>/dev/null
        echo ""
        echo "=== [4] EEM VOLTAGE & SCHEDUTIL LOG ==="
        tail -n 20 "$VOLT_LOG" 2>/dev/null
        echo ""
        echo "=== [5] KERNEL NODE WRITE AUDIT ==="
        tail -n 25 "$AUDIT_LOG" 2>/dev/null
        ;;
    esac
    ;;
  clear_logs)
    for f in "$OCORE_LOG" "$AUDIT_LOG" "$DAEMON_LOG" "$ERROR_LOG" "$VOLT_LOG" "$PERF_HIST_LOG" "$GAME_SESS_LOG" "$TX_LOG" "$LOG_DIR/self_diagnostic_report.log" "$THERMOD_DIR/logs/thermod.log" "$AZ_CONF_DIR/sysmon.log"; do
      : > "$f" 2>/dev/null
    done
    rm -f "$STATE_DIR"/crash_* "$STATE_DIR"/cooldown_* "$MODDIR"/ocoin_*.log "$MODDIR"/rairin_*.log /data/local/tmp/ocoin_*.log /data/local/tmp/rairin_*.log 2>/dev/null
    for _pl in "$MODDIR"/ocore_*.log; do [ -f "$_pl" ] && : > "$_pl" 2>/dev/null; done
    echo "[$(date "+%Y-%m-%d %H:%M:%S")] [INFO] [BOOT_LOG] Preserved boot trace header after clear_logs" > "$BOOT_LOG"
    "$MODDIR/system/bin/sys.ocore-service" --clearlogs 2>/dev/null
    verify_eem_persistence_if_needed >/dev/null 2>&1
    evaluate_and_apply_arbiter >/dev/null 2>&1
    log_tx "APPLIED" "clear_logs" "Cleared diagnostic logs and re-verified active state"
    echo "[OK] All diagnostic logs cleared and active state re-verified"
    ;;
  guard|fpsgo|ged|zones|decrypt|encrypt)
    "$MODDIR/system/bin/thermod" "$cmd" "$2"
    ;;
  *)
    log_tx "FAILED" "unknown_cmd" "Disallowed command: $cmd"
    echo "[ERROR] Disallowed or unknown ocorectl command: $cmd"
    exit 1
    ;;
esac

  echo "SMART_CHARGE_STOP=$SMART_CHARGE_STOP"
  echo "SMART_CHARGE_RESUME=$SMART_CHARGE_RESUME"
  echo "CHG_SUPPORTED=${HW_CHG_SUPPORTED:-0}"
  echo "CHG_NODE=${HW_CHG_NODE:-UNSUPPORTED}"
  echo "ZRAM_SWAPPINESS=$SWP_CUR"
  echo "TCP_CONG=$TCP_CUR"
  echo "TCP_LOW_LATENCY=$TCP_LOW_LATENCY"
  echo "PRIVATE_DNS_MODE=$PRIVATE_DNS_MODE"
  echo "DEEP_DOZE_ENABLE=$DEEP_DOZE_ENABLE"
  echo "MTK_APU_DRAM_BOOST=$MTK_APU_DRAM_BOOST"
  echo "AUTO_APPLY_RECOMMENDATION=${AUTO_APPLY_RECOMMENDATION:-0}"
  echo "DEBUG_VERBOSE=${DEBUG_VERBOSE:-1}"
  echo "ERR_COUNT=$ERR_COUNT"
  echo "DETECTED_CONFLICTS=${CONFLICTS_STR:-None}"
  echo "HW_MODEL=${HW_MODEL:-Unknown}"
  echo "HW_DEVICE=${HW_DEVICE:-Unknown}"
  echo "HW_SOC_FAM=${HW_SOC_FAM:-Unknown}"
  echo "HW_ANDROID=${HW_ANDROID:-Unknown}"
  echo "HW_KERNEL=${HW_KERNEL:-Unknown}"
  echo "HW_ROOT_MGR=${HW_ROOT_MGR:-Unknown}"
  echo "HW_CPU_CLUSTERS=${HW_CPU_CLUSTERS:-Dynamic}"
  echo "HW_GPU_ARCH=${HW_GPU_ARCH:-Generic}"
  echo "HW_GED_SUPPORTED=${HW_GED_SUPPORTED:-0}"
  echo "HW_FPSGO_SUPPORTED=${HW_FPSGO_SUPPORTED:-0}"
  echo "HW_MTK_THERM_SUPPORTED=${HW_MTK_THERM_SUPPORTED:-0}"
  echo "BATT_PROV=$BATT_PROV"

#!/system/bin/sh
# ==============================================================================
# Ocore Unified Performance Engine — Master Controller (ocorectl v3.2.0-NextGen)
# Engineering Revision v3.2.0-NextGen.2 Highlights:
#   1. 6-Tier Performance Arbiter:
#        Priority 1: Thermal Protection
#        Priority 2: Safety Recovery (Safe Mode / Bootloop Guard)
#        Priority 3: User Manual Override
#        Priority 4: Gaming Profile (Verified Foreground Game Session)
#        Priority 5: Global Performance Profile
#        Priority 6: Background Optimization (Screen-Off / Idle)
#   2. 7-Step Configuration Transaction Manager:
#        Backup -> Validate -> Capability Check -> Apply -> Readback Verify -> Commit -> Rollback
#        Emits: TRANSACTION_STATUS=<APPLIED|PARTIAL|UNSUPPORTED|FAILED|ROLLED_BACK>
#   3. EEM Stability Framework:
#        Captures pre-modification initial hardware offsets per rail (never assumes 0 is stock!)
#        Modes: STOCK (Initial Baseline), CONSERVATIVE (-3/-3/-2/-2), CUSTOM, DISABLED
#        Per-rail independent validation, readback verification & rollback
#   4. Frame Stability Intelligence:
#        Computes P50/P90/P95/P99 frame-time (ms), Jank %, and Frame Duration from dumpsys gfxinfo
#   5. Ocore Performance Intelligence:
#        Multi-factor heuristic scoring engine (advisory by default; never mislabels static scripts as AI)
#   6. Ocore Recovery Center:
#        Full CLI & WebUI recovery (emergency_safe_mode, bootloop_recovery, config_restore,
#        kernel_node_restore, thermal_restore, eem_restore, daemon_recovery, diag_export)
# ==============================================================================

MODDIR="${MODDIR_OVERRIDE:-/data/adb/modules/Ocore}"
[ ! -d "$MODDIR" ] && MODDIR="/data/adb/modules/Ocore"
if [ ! -d "$MODDIR" ]; then
  SCRIPT_DIR="${0%/*}"
  if [ -f "$SCRIPT_DIR/../../module.prop" ]; then
    MODDIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
  fi
fi

OCORE_DIR="${OCORE_DIR_OVERRIDE:-/data/adb/ocore}"
OCORE_CONF="$OCORE_DIR/config.conf"
LOG_DIR="$OCORE_DIR/logs"
STATE_DIR="$OCORE_DIR/state"
BACKUP_DIR="$OCORE_DIR/backups"

# Structured Log Files
OCORE_LOG="$LOG_DIR/ocore_events.log"
BOOT_LOG="$LOG_DIR/boot_trace.log"
AUDIT_LOG="$LOG_DIR/kernel_nodes_audit.log"
DAEMON_LOG="$LOG_DIR/daemons_watchdog.log"
ERROR_LOG="$LOG_DIR/errors.log"
VOLT_LOG="$LOG_DIR/volt_optimizer.log"
PERF_HIST_LOG="$LOG_DIR/perf_history.log"
GAME_SESS_LOG="$LOG_DIR/gaming_sessions.log"
TX_LOG="$LOG_DIR/transactions.log"

THERMOD_DIR="${THERMOD_DIR_OVERRIDE:-/data/adb/thermod_mt6877}"
AZ_CONF_DIR="${AZ_CONF_OVERRIDE:-/data/adb/.config/ocore}"
RR_TMP_DIR="${RR_TMP_OVERRIDE:-/data/local/tmp/ocore}"

if [ ! -d "$STATE_DIR/spoof_bindings" ] || [ ! -d "$RR_TMP_DIR/render" ]; then
  mkdir -p "$OCORE_DIR/config" "$OCORE_DIR/runtime" "$OCORE_DIR/hw" "$LOG_DIR" "$STATE_DIR/locks" "$STATE_DIR/per_game" "$STATE_DIR/spoof_bindings" "$BACKUP_DIR" "$THERMOD_DIR/logs" \
    "$MODDIR/backup" "$MODDIR/state" "/data/adb/ocore/state" \
    "$AZ_CONF_DIR/API" "$AZ_CONF_DIR/debug" "$AZ_CONF_DIR/bypasschgconfig" "$AZ_CONF_DIR/gamelist" \
    "$RR_TMP_DIR/render" "/data/data/zx.ocore/API" 2>/dev/null
fi

# Source modular engine subsystems (fast-path for `status` loads memory + gaming/fps engines)
if [ "${1:-status}" = "status" ]; then
  [ ! -f "$STATE_DIR/hw_capabilities.env" ] && [ -f "$MODDIR/engine/core/hw_detect.sh" ] && . "$MODDIR/engine/core/hw_detect.sh"
  [ -f "$MODDIR/engine/core/memory_storage_engine.sh" ] && . "$MODDIR/engine/core/memory_storage_engine.sh"
  [ -f "$MODDIR/engine/core/gaming_engine.sh" ] && . "$MODDIR/engine/core/gaming_engine.sh"
else
  for _mod_sh in \
    "$MODDIR/engine/core/core_engine.sh" \
    "$MODDIR/engine/core/hw_detect.sh" \
    "$MODDIR/engine/core/arbiter.sh" \
    "$MODDIR/engine/core/cpu_engine.sh" \
    "$MODDIR/engine/core/gpu_engine.sh" \
    "$MODDIR/engine/core/thermal_engine.sh" \
    "$MODDIR/engine/core/voltage_engine.sh" \
    "$MODDIR/engine/core/gaming_engine.sh" \
    "$MODDIR/engine/core/device_profile_engine.sh" \
    "$MODDIR/engine/core/renderer_engine.sh" \
    "$MODDIR/engine/core/battery_engine.sh" \
    "$MODDIR/engine/core/memory_storage_engine.sh" \
    "$MODDIR/engine/core/daemon_manager.sh" \
    "$MODDIR/engine/core/diagnostics_engine.sh" \
    "$MODDIR/engine/core/recovery_manager.sh" \
    "$MODDIR/engine/core/webui_bridge.sh"; do
    [ -f "$_mod_sh" ] && . "$_mod_sh"
  done
fi


# ==============================================================================
# LOGGING & SANITIZATION HELPERS (Scoped Variables — Zero Caller Collisions!)
# ==============================================================================
rotate_log_if_needed() {
  _rl_lf="$1"
  if [ -f "$_rl_lf" ]; then
    _rl_sz=$(wc -c < "$_rl_lf" 2>/dev/null | tr -dc '0-9')
    if [ -n "$_rl_sz" ] && [ "$_rl_sz" -gt 524288 ]; then
      mv -f "$_rl_lf" "${_rl_lf}.old" 2>/dev/null
      echo "[$(date '+%Y-%m-%d %H:%M:%S')] [INFO] [LOG_ROTATE] Rotated $_rl_lf (>512KB)" > "$_rl_lf"
    fi
  fi
}

log_event() {
  _le_lvl="${1:-INFO}"
  _le_comp="${2:-OCORE}"
  _le_msg="$3"
  _le_ts="$(date '+%Y-%m-%d %H:%M:%S')"
  rotate_log_if_needed "$OCORE_LOG"
  echo "[$_le_ts] [$_le_lvl] [$_le_comp] $_le_msg" >> "$OCORE_LOG" 2>/dev/null
  if [ "$_le_lvl" = "ERROR" ] || [ "$_le_lvl" = "WARN" ] || [ "$_le_lvl" = "CRIT" ]; then
    rotate_log_if_needed "$ERROR_LOG"
    echo "[$_le_ts] [$_le_lvl] [$_le_comp] $_le_msg" >> "$ERROR_LOG" 2>/dev/null
  fi
}

log_tx() {
  _tx_status="$1"
  _tx_op="$2"
  _tx_detail="$3"
  _tx_ts="$(date '+%Y-%m-%d %H:%M:%S')"
  rotate_log_if_needed "$TX_LOG"
  echo "[$_tx_ts] [TX:$_tx_status] [$_tx_op] $_tx_detail" >> "$TX_LOG" 2>/dev/null
  echo "$_tx_status|$_tx_op|$_tx_detail|$_tx_ts" > "$STATE_DIR/last_transaction.txt" 2>/dev/null
  echo "TRANSACTION_STATUS=$_tx_status"
}

sanitize_token() {
  printf "%s" "$1" | tr -dc 'a-zA-Z0-9_.:/-'
}

sanitize_int() {
  _si_val=$(printf "%s" "$1" | tr -dc '0-9-')
  case "$_si_val" in
    ""|"-") echo "${2:-0}" ;;
    *) echo "$_si_val" ;;
  esac
}

validate_package_name() {
  _vp_pkg="$1"
  echo "$_vp_pkg" | grep -Eq '^[a-zA-Z][a-zA-Z0-9_]*(\.[a-zA-Z0-9_]+)+$' || return 1
  case "$_vp_pkg" in
    android|system|com.android.systemui|com.android.settings|com.android.phone|com.android.nfc|me.weishu.kernelsu|com.rifsxd.ksunext|me.bmax.apatch|com.topjohnwu.magisk)
      return 1
      ;;
  esac
  return 0
}

# ==============================================================================
# TRANSACTION-AWARE KERNEL NODE I/O (Backup -> Write -> Readback -> Rollback)
# ==============================================================================
capture_initial_node_baseline() {
  _cnb_node="$1"
  [ -e "$_cnb_node" ] || return 1
  _cnb_bfile="$BACKUP_DIR/kernel_nodes_initial.env"
  touch "$_cnb_bfile" 2>/dev/null
  _cnb_key=$(echo "$_cnb_node" | tr '/.-' '___')
  if ! grep -q "^${_cnb_key}=" "$_cnb_bfile" 2>/dev/null; then
    _cnb_cur=$(head -n 1 "$_cnb_node" 2>/dev/null | tr -d '\r\n')
    echo "${_cnb_key}=${_cnb_node}|${_cnb_cur}" >> "$_cnb_bfile" 2>/dev/null
  fi
}

safe_write_node() {
  _sw_comp="$1"
  _sw_node="$2"
  _sw_val="$3"
  _sw_perm="${4:-0644}"
  _sw_verify="${5:-0}"
  _sw_optional="${6:-0}"
  _sw_ts="$(date '+%Y-%m-%d %H:%M:%S')"

  if [ ! -e "$_sw_node" ]; then
    [ "${DEBUG_VERBOSE:-1}" = "1" ] && echo "[$_sw_ts] [SKIP:UNSUPPORTED] [$_sw_comp] Node not present: $_sw_node" >> "$AUDIT_LOG" 2>/dev/null
    return 2
  fi

  capture_initial_node_baseline "$_sw_node"
  _sw_prev=$(head -n 1 "$_sw_node" 2>/dev/null | tr -d '\r\n')

  # If current kernel value already equals desired target, avoid redundant write
  if [ "$_sw_prev" = "$_sw_val" ] || \
     { [ "$_sw_val" = "Y" ] && [ "$_sw_prev" = "1" ]; } || \
     { [ "$_sw_val" = "1" ] && [ "$_sw_prev" = "Y" ]; } || \
     { [ "$_sw_val" = "N" ] && [ "$_sw_prev" = "0" ]; } || \
     { [ "$_sw_val" = "0" ] && [ "$_sw_prev" = "N" ]; }; then
    [ "${DEBUG_VERBOSE:-1}" = "1" ] && echo "[$_sw_ts] [OK]   [$_sw_comp] Verified '$_sw_val' on $_sw_node (Readback: '$_sw_prev')" >> "$AUDIT_LOG" 2>/dev/null
    return 0
  fi

  chmod "$_sw_perm" "$_sw_node" 2>/dev/null
  _sw_err=$( (echo "$_sw_val" > "$_sw_node") 2>&1 )
  _sw_rc=$?

  if [ $_sw_rc -ne 0 ]; then
    # Check if this is an optional / compile-time locked module parameter
    case "$_sw_node" in
      /sys/module/*/parameters/*) _sw_optional="1" ;;
    esac
    if [ "$_sw_optional" = "1" ]; then
      [ "${DEBUG_VERBOSE:-1}" = "1" ] && echo "[$_sw_ts] [SKIP:KERNEL_LOCKED] [$_sw_comp] Optional param $_sw_node is read-only on this kernel (current='$_sw_prev')" >> "$AUDIT_LOG" 2>/dev/null
      return 0
    fi
    log_event "ERROR" "$_sw_comp" "Write '$_sw_val' -> $_sw_node FAILED (rc=$_sw_rc, err=${_sw_err:-rejected})"
    echo "[$_sw_ts] [FAIL] [$_sw_comp] Write '$_sw_val' -> $_sw_node FAILED (rc=$_sw_rc, err=$_sw_err)" >> "$AUDIT_LOG" 2>/dev/null
    return 1
  fi

  _sw_rb=$(head -n 1 "$_sw_node" 2>/dev/null | tr -d '\r\n')
  if [ "$_sw_verify" = "1" ] && [ "$_sw_rb" != "$_sw_val" ]; then
    [ -n "$_sw_prev" ] && echo "$_sw_prev" > "$_sw_node" 2>/dev/null
    log_event "WARN" "$_sw_comp" "Readback mismatch on $_sw_node (expected '$_sw_val', got '$_sw_rb'); rolled back to '$_sw_prev'"
    echo "[$_sw_ts] [ROLLED_BACK] [$_sw_comp] $_sw_node expected '$_sw_val', got '$_sw_rb' -> restored '$_sw_prev'" >> "$AUDIT_LOG" 2>/dev/null
    return 3
  fi

  [ "${DEBUG_VERBOSE:-1}" = "1" ] && echo "[$_sw_ts] [OK]   [$_sw_comp] Write '$_sw_val' -> $_sw_node (Readback: '$_sw_rb')" >> "$AUDIT_LOG" 2>/dev/null
  return 0
}

run_tracked() {
  _rt_comp="$1"
  _rt_desc="$2"
  shift 2
  _rt_tmp="$STATE_DIR/.ocore_cmd_err_$$"
  _rt_out=$("$@" 2>"$_rt_tmp")
  _rt_rc=$?
  _rt_err=$(tr '\n' ' ' < "$_rt_tmp" 2>/dev/null)
  rm -f "$_rt_tmp" 2>/dev/null

  if [ $_rt_rc -ne 0 ]; then
    log_event "ERROR" "$_rt_comp" "$_rt_desc FAILED (exit=$_rt_rc) cmd='$*' stderr='${_rt_err:-none}' stdout='${_rt_out:-none}'"
  else
    [ "${DEBUG_VERBOSE:-1}" = "1" ] && log_event "DEBUG" "$_rt_comp" "$_rt_desc OK (exit=0) cmd='$*'"
  fi
  [ -n "$_rt_out" ] && echo "$_rt_out"
  return $_rt_rc
}

